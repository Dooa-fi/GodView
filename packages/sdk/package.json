{
  "name": "@godview/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/auto.ts --bundle --format=iife --outfile=dist/godview.js && cp dist/godview.js dist/sdk.js",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@godview/shared": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "happy-dom": "20.14.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
