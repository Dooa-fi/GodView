# Required in Railway production. Keep the token server-side; do not prefix it with NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ANALYTICS_DATASET=GODVIEW_EVENTS
GODVIEW_SITE_ID=site_123

# Optional: Collector provisioning URL & admin token for multi-site management
# GODVIEW_COLLECTOR_URL=https://your-collector.workers.dev
# GODVIEW_ADMIN_TOKEN=your-admin-secret-token

# Optional: render realistic sample data without contacting Cloudflare.
GODVIEW_DEMO_MODE=false

# Legacy aliases supported for backward compatibility:
# OPENPULSE_SITE_ID, OPENPULSE_DEMO_MODE, OPENPULSE_COLLECTOR_URL, OPENPULSE_ADMIN_TOKEN

